# Native authored-fixture profile works without Docker. Uploaded archives require isolation.
ECDAT_PROFILE=native-fixtures
ECDAT_DEMO=1
# Deployment database: postgresql+psycopg://ecdat:YOUR_LOCAL_PASSWORD@127.0.0.1:5433/ecdat
# ECDAT_DATABASE_URL=
# For a configured local inference server:
ECDAT_AI_PROVIDER=ollama
ECDAT_AI_MODEL=qwen3:1.7b
# Cloud alternatives accept public-demo evidence only. No billing is enabled by ECDAT.
# ECDAT_AI_PROVIDER=groq
# ECDAT_AI_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Set true with HTTPS outside local development.
ECDAT_COOKIE_SECURE=0
