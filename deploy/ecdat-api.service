[Unit]
Description=ECDAT FastAPI Service
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ecdat
Group=ecdat
WorkingDirectory=/opt/ecdat
Environment="PYTHONPATH=/opt/ecdat/services/api"
EnvironmentFile=/etc/ecdat/ecdat.env
ExecStart=/opt/ecdat/.venv/bin/python -m uvicorn ecdat.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
