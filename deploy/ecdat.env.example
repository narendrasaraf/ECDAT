# ECDAT Production Environment Configuration Example
# Save as /etc/ecdat/ecdat.env with strict permissions (chmod 600 /etc/ecdat/ecdat.env)

# Scanner Profile: 'isolated' uses secure, network-isolated Docker containers for scan execution
ECDAT_PROFILE=isolated

# Production Mode: 0 disables public-demo initialization and automatic demo accounts
ECDAT_DEMO=0

# API Worker Thread: 0 because the worker runs as a separate systemd service (ecdat-worker.service)
ECDAT_WORKER=0

# Security: 1 enforces Secure attribute on session cookies when served over HTTPS
ECDAT_COOKIE_SECURE=1

# PostgreSQL Database Credentials
ECDAT_POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD
ECDAT_DATABASE_URL=postgresql+psycopg://ecdat:CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD@127.0.0.1:5432/ecdat

# AI Provider Configuration (Local offline Ollama bound to localhost only)
ECDAT_AI_PROVIDER=ollama
ECDAT_AI_MODEL=qwen3:1.7b
OLLAMA_HOST=http://127.0.0.1:11434

# Allowed Public Origin (used for CSRF verification on state-changing API endpoints)
ECDAT_ORIGIN=https://ecdat.example.com
