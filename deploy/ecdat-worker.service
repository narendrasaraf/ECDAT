[Unit]
Description=ECDAT Trusted Host Worker Service
After=network.target ecdat-api.service docker.service
Wants=ecdat-api.service docker.service

[Service]
Type=simple
User=ecdat
Group=docker
WorkingDirectory=/opt/ecdat
Environment="PYTHONPATH=/opt/ecdat/services/api"
EnvironmentFile=/etc/ecdat/ecdat.env
ExecStart=/opt/ecdat/.venv/bin/python -m ecdat.worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
